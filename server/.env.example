# Copy this file to `.env` (server) and fill in real values for production.
# These are read by server/server.js via process.env.

# Port the API listens on (default 4000)
PORT=4000

# Secret used to sign JWTs. MUST be a long, random, private value in production.
JWT_SECRET=change-me-to-a-long-random-string

# How long issued tokens stay valid (e.g. 15m, 1h, 2h)
JWT_EXPIRES_IN=2h

# Frontend origin allowed by CORS (the Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# Set to "production" to hide internal error messages
NODE_ENV=development
